!R-2#

en
config t
host R-2
int g0/2
ip add 2.2.2.1 255.255.255.252
ip nat outside
no shut

int g0/0
ip add 4.4.4.1 255.255.255.252
ip nat outside
no shut

int g0/3
description HSRP_ON_SUB_INTENFACE
no shut

int g0/3.10
ip nat inside
encapsulation dot1Q 10
ip address 10.1.1.2 255.255.255.0
standby version 2
standby 10 ip 10.1.1.3
standby 10 priority 100
standby 10 preempt

int g0/3.20
ip nat inside
encapsulation dot1Q 20
ip address 20.1.1.2 255.255.255.0
standby version 2
standby 20 ip 20.1.1.3
standby 20 priority 110
standby 20 preempt
exit

! IP SLA - ISP1
ip sla 3
icmp-echo 4.4.4.2 source-int g0/0
timeout 1000
frequency 5
exit

ip sla schedule 3 life forever start-time now

! IP SLA - ISP2
ip sla 4
icmp-echo 2.2.2.2 source-int g0/2
timeout 1000
frequency 5
exit

ip sla schedule 4 life forever start-time now

! TRACKING
track 3 ip sla 3 reachability
track 4 ip sla 4 reachability

! DEFAULT ROUTES
! ISP1 PRIMARY
! ISP2 BACKUP
ip route 0.0.0.0 0.0.0.0 4.4.4.2 track 3
ip route 0.0.0.0 0.0.0.0 2.2.2.2 20 track 4

! NAT ACL
ip access-list standard NAT
permit 10.1.1.0 0.0.0.255
permit 20.1.1.0 0.0.0.255
exit

! NAT ROUTE-MAPS
route-map NAT-ISP1 permit 10
match ip address NAT
match int g0/0

route-map NAT-ISP2 permit 10
match ip address NAT
match int g0/2

! PAT
ip nat inside source route-map NAT-ISP1 int g0/0 overload
ip nat inside source route-map NAT-ISP2 int g0/2 overload

end
write memory

